# Servidor
PORT=3000

# Postgres — aponte para o banco já disponível na VPS da empresa.
# Nunca commitar o .env real (já está no .gitignore).
DATABASE_URL="postgresql://usuario:senha@host:5432/estoq?schema=public"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-e-unico"
JWT_EXPIRES_IN="12h"

# API Gateway do Sankhya (OAuth2 client_credentials) — dados obtidos na
# "Área do desenvolvedor" (Client ID/Secret) e na tela "Configurações do
# Gateway" (X-Token) do Sankhya Om.
# Nunca colar esses valores em conversas — só no .env local.
SANKHYA_AMBIENTE="sandbox"
SANKHYA_CLIENT_ID=""
SANKHYA_CLIENT_SECRET=""
SANKHYA_X_TOKEN=""
SANKHYA_CODEMP=1
SANKHYA_DIAS_HISTORICO=30
