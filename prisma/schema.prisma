// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMIN
  OPERADOR
}

// Usuários do app (login/senha próprios, independentes do Sankhya).
model Usuario {
  id        String       @id @default(uuid())
  nome      String
  login     String       @unique
  senhaHash String
  role      PapelUsuario
  criadoEm  DateTime     @default(now())

  atribuicoes   MovimentacaoAtribuicao[]
  conferencias  ConferenciaResultado[]
  itemAtribuicoes  ItemAtribuicao[]
  itemConferencias ItemConferenciaResultado[]

  @@map("usuarios")
}

// Camada de "overlay" sobre a movimentação que existe no Sankhya: só guarda
// quem é o responsável por conferi-la. O restante do dado (nota, itens,
// quantidade esperada) vem ao vivo da API do Sankhya — não é duplicado aqui.
model MovimentacaoAtribuicao {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId             String?
  atualizadoEm          DateTime @updatedAt

  @@map("movimentacao_atribuicoes")
}

// Resultado de uma conferência física finalizada. Guarda um snapshot de
// nota/tipo/parceiro no momento da conferência para não depender de nova
// consulta ao Sankhya ao listar divergências/indicadores.
model ConferenciaResultado {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  numeroNota            String
  tipo                  String
  parceiro              String
  empresaCodigo         String
  conferidoPor          Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId        String
  dataConferencia       DateTime

  itens        ItemConferido[]
  divergencias Divergencia[]

  @@map("conferencia_resultados")
}

model ItemConferido {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  // Código do local de armazenagem (extraído do itemSankhyaId, que já vem
  // como "{nunota}-{codigoProduto}-{localCodigo}") — precisa ficar salvo
  // aqui pra conferência diária casar contagens com produto+local+empresa+dia
  // sem depender de uma nova consulta ao Sankhya.
  localCodigo         String
  // Float, não Int: TGFEST.ESTOQUE pode ser fracionário (produtos vendidos
  // por metro/kg, ex: "118.17"). Int aqui derrubava o salvamento da
  // conferência pra qualquer produto medido em unidade fracionária.
  quantidadeEsperada  Float
  quantidadeConferida Int?

  @@map("itens_conferidos")
}

// Camada de "overlay" de atribuição por grupo produto+local, substituindo a
// atribuição por nota (MovimentacaoAtribuicao, acima): a unidade de trabalho
// da conferência física é "esse produto, nesse local" — o mesmo produto+local
// costuma aparecer espalhado em várias notas dentro do período, e não fazia
// sentido o admin ter que atribuir nota a nota pro operador ir contar a
// mesma prateleira várias vezes. `chave` é "{empresaCodigo}|{codigoProduto}|{localCodigo}",
// mesmo formato já usado em conferenciaDiaria.service.ts.
model ItemAtribuicao {
  id            String   @id @default(uuid())
  chave         String   @unique
  empresaCodigo String
  codigoProduto String
  localCodigo   String
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId     String?
  atualizadoEm  DateTime @updatedAt

  @@map("item_atribuicoes")
}

// Resultado da conferência física de um grupo produto+local: uma única
// contagem cega que vale pra todas as notas daquele produto+local no
// período (quantidadeEsperada já é o estoque físico do local — igual pra
// qualquer nota que passe por ali, não faz sentido contar nota a nota).
model ItemConferenciaResultado {
  id                  String   @id @default(uuid())
  chave               String   @unique
  empresaCodigo       String
  codigoProduto       String
  descricao           String
  local               String
  localCodigo         String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  conferidoPor        Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId      String
  dataConferencia     DateTime
  motivo              String?
  observacao          String?
  comentarioAdmin     String?

  @@map("item_conferencia_resultados")
}

model Divergencia {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  descricao           String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  motivo              String
  observacao          String?
  comentarioAdmin     String?

  @@map("divergencias")
}
