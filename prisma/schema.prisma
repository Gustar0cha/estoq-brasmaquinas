// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMIN
  OPERADOR
}

// Usuários do app (login/senha próprios, independentes do Sankhya).
model Usuario {
  id        String       @id @default(uuid())
  nome      String
  login     String       @unique
  senhaHash String
  role      PapelUsuario
  criadoEm  DateTime     @default(now())

  atribuicoes   MovimentacaoAtribuicao[]
  conferencias  ConferenciaResultado[]
  itemAtribuicoes  ItemAtribuicao[]
  itemConferencias ItemConferenciaResultado[]
  segundasContagensSolicitadas ItemSolicitacaoSegundaContagem[] @relation("SolicitacoesFeitas")
  segundasContagensAtribuidas  ItemSolicitacaoSegundaContagem[] @relation("SolicitacoesAtribuidas")

  contagensIniciadas          ContagemEstoque[]
  contagemItensAtribuidos1    ContagemItem[] @relation("ContagemItensAtribuidos1")
  contagemItensConferidos1    ContagemItem[] @relation("ContagemConferidaPor1")
  contagemItensAtribuidos2    ContagemItem[] @relation("ContagemItensAtribuidos2")
  contagemItensConferidos2    ContagemItem[] @relation("ContagemConferidaPor2")
  contagemSegundasSolicitadas ContagemItem[] @relation("ContagemSegundaSolicitadaPor")

  @@map("usuarios")
}

// Camada de "overlay" sobre a movimentação que existe no Sankhya: só guarda
// quem é o responsável por conferi-la. O restante do dado (nota, itens,
// quantidade esperada) vem ao vivo da API do Sankhya — não é duplicado aqui.
model MovimentacaoAtribuicao {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId             String?
  atualizadoEm          DateTime @updatedAt

  @@map("movimentacao_atribuicoes")
}

// Resultado de uma conferência física finalizada. Guarda um snapshot de
// nota/tipo/parceiro no momento da conferência para não depender de nova
// consulta ao Sankhya ao listar divergências/indicadores.
model ConferenciaResultado {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  numeroNota            String
  tipo                  String
  parceiro              String
  empresaCodigo         String
  conferidoPor          Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId        String
  dataConferencia       DateTime

  itens        ItemConferido[]
  divergencias Divergencia[]

  @@map("conferencia_resultados")
}

model ItemConferido {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  // Código do local de armazenagem (extraído do itemSankhyaId, que já vem
  // como "{nunota}-{codigoProduto}-{localCodigo}") — precisa ficar salvo
  // aqui pra conferência diária casar contagens com produto+local+empresa+dia
  // sem depender de uma nova consulta ao Sankhya.
  localCodigo         String
  // Float, não Int: TGFEST.ESTOQUE pode ser fracionário (produtos vendidos
  // por metro/kg, ex: "118.17"). Int aqui derrubava o salvamento da
  // conferência pra qualquer produto medido em unidade fracionária.
  quantidadeEsperada  Float
  quantidadeConferida Int?

  @@map("itens_conferidos")
}

// Camada de "overlay" de atribuição por grupo produto+local, substituindo a
// atribuição por nota (MovimentacaoAtribuicao, acima): a unidade de trabalho
// da conferência física é "esse produto, nesse local" — o mesmo produto+local
// costuma aparecer espalhado em várias notas dentro do período, e não fazia
// sentido o admin ter que atribuir nota a nota pro operador ir contar a
// mesma prateleira várias vezes. `chave` é "{empresaCodigo}|{codigoProduto}|{localCodigo}",
// mesmo formato já usado em conferenciaDiaria.service.ts.
model ItemAtribuicao {
  id            String   @id @default(uuid())
  chave         String   @unique
  empresaCodigo String
  codigoProduto String
  localCodigo   String
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId     String?
  atualizadoEm  DateTime @updatedAt

  @@map("item_atribuicoes")
}

// Resultado da conferência física de um grupo produto+local: uma contagem
// cega que vale pra todas as notas daquele produto+local no período
// (quantidadeEsperada já é o estoque físico do local — igual pra qualquer
// nota que passe por ali, não faz sentido contar nota a nota).
// numeroContagem 1 é a contagem original; 2 é a recontagem pedida pelo
// gestor quando a 1ª diverge (ver ItemSolicitacaoSegundaContagem) — cada
// chave pode ter até duas linhas aqui, uma por número de contagem.
model ItemConferenciaResultado {
  id                  String   @id @default(uuid())
  chave               String
  numeroContagem      Int      @default(1)
  empresaCodigo       String
  codigoProduto       String
  descricao           String
  local               String
  localCodigo         String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  conferidoPor        Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId      String
  dataConferencia     DateTime
  motivo              String?
  observacao          String?
  comentarioAdmin     String?
  // Valores lidos pelo leitor de código de barras/QR no momento da
  // contagem — guardados só como evidência de que o operador bipou algo
  // fisicamente ali (o Sankhya não tem código de barras cadastrado nos
  // produtos nesse ambiente, então não há o que validar contra).
  codigoLocalBipado    String?
  codigoProdutoBipado  String?
  // Chave do objeto no MinIO (nunca uma URL pública) — a foto só é servida
  // via proxy autenticado da nossa API, o app não recebe acesso direto ao
  // bucket nem essa foto aparece em nenhuma tela do operador.
  fotoChaveArmazenamento String?

  @@unique([chave, numeroContagem])
  @@map("item_conferencia_resultados")
}

// Fica registrada quando o gestor pede recontagem de um item com
// divergência na 1ª contagem. Enquanto existir sem a 2ª contagem
// correspondente em ItemConferenciaResultado, o item aparece pro
// `usuarioId` atribuído como "aguardando 2ª contagem".
model ItemSolicitacaoSegundaContagem {
  id              String   @id @default(uuid())
  chave           String   @unique
  solicitadoPor   Usuario  @relation("SolicitacoesFeitas", fields: [solicitadoPorId], references: [id])
  solicitadoPorId String
  usuario         Usuario? @relation("SolicitacoesAtribuidas", fields: [usuarioId], references: [id])
  usuarioId       String?
  criadoEm        DateTime @default(now())

  @@map("item_solicitacoes_segunda_contagem")
}

// Central de avisos pro gestor — hoje só divergência de 1ª contagem, mas o
// `tipo` já deixa aberto pra outros avisos no futuro sem mudar o schema.
model Notificacao {
  id        String   @id @default(uuid())
  tipo      String
  chave     String
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@map("notificacoes")
}

// Sessão de contagem física do estoque todo (ou de uma empresa), disparada
// pelo admin em "Iniciar contagem". Ao contrário do fluxo de Movimentações
// (que reconstrói o grupo produto+local ao vivo a partir das notas do
// Sankhya a cada request), aqui a lista de itens e a quantidade esperada são
// um retrato congelado da cópia de estoque (TGFCTE) no momento em que a
// contagem começou — uma auditoria física não pode ficar mudando de alvo
// enquanto as pessoas estão andando pelo depósito contando.
model ContagemEstoque {
  id            String    @id @default(uuid())
  numero        Int       @default(autoincrement())
  empresaCodigo String?
  empresaNome   String?
  status        String    @default("EM_ANDAMENTO")
  iniciadaPor   Usuario   @relation(fields: [iniciadaPorId], references: [id])
  iniciadaPorId String
  iniciadaEm    DateTime  @default(now())
  finalizadaEm  DateTime?

  itens ContagemItem[]

  @@map("contagem_estoques")
}

// Uma linha produto+local dentro de uma sessão de contagem. Guarda 1ª e 2ª
// contagem no mesmo registro (ao contrário de ItemConferenciaResultado, que
// usa uma linha por número de contagem) porque aqui a linha já nasce fixa
// pra uma sessão específica — não precisa reconciliar com múltiplas notas.
model ContagemItem {
  id         String          @id @default(uuid())
  contagem   ContagemEstoque @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId String

  empresaCodigo      String
  empresaNome        String
  codigoProduto      String
  descricao          String
  unidade            String
  local              String
  localCodigo        String
  quantidadeEsperada Float
  dataCopiaEstoque   DateTime?

  status    String   @default("PENDENTE")
  usuario   Usuario? @relation("ContagemItensAtribuidos1", fields: [usuarioId], references: [id])
  usuarioId String?

  // 1ª contagem
  quantidadeConferida    Int?
  diferenca              Float?
  motivo                 String?
  observacao             String?
  comentarioAdmin        String?
  dataConferencia        DateTime?
  conferidoPor           Usuario?  @relation("ContagemConferidaPor1", fields: [conferidoPorId], references: [id])
  conferidoPorId         String?
  codigoLocalBipado      String?
  codigoProdutoBipado    String?
  fotoChaveArmazenamento String?

  // pedido de 2ª contagem
  segundaContagemSolicitada      Boolean  @default(false)
  segundaContagemSolicitadaPor   Usuario? @relation("ContagemSegundaSolicitadaPor", fields: [segundaContagemSolicitadaPorId], references: [id])
  segundaContagemSolicitadaPorId String?
  segundaContagemUsuario         Usuario? @relation("ContagemItensAtribuidos2", fields: [segundaContagemUsuarioId], references: [id])
  segundaContagemUsuarioId       String?

  // 2ª contagem
  quantidadeConferida2    Int?
  diferenca2               Float?
  motivo2                  String?
  observacao2              String?
  dataConferencia2         DateTime?
  conferidoPor2            Usuario?  @relation("ContagemConferidaPor2", fields: [conferidoPor2Id], references: [id])
  conferidoPor2Id          String?
  codigoLocalBipado2       String?
  codigoProdutoBipado2     String?
  fotoChaveArmazenamento2  String?

  @@unique([contagemId, codigoProduto, localCodigo])
  @@map("contagem_itens")
}

model Divergencia {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  descricao           String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  motivo              String
  observacao          String?
  comentarioAdmin     String?

  @@map("divergencias")
}
