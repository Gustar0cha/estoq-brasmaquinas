// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMIN
  OPERADOR
}

// Usuários do app (login/senha próprios, independentes do Sankhya).
model Usuario {
  id        String       @id @default(uuid())
  nome      String
  login     String       @unique
  senhaHash String
  role      PapelUsuario
  // Loja do usuário (ver src/lib/filiais.ts). Só enxerga locais cujo CODLOCAL
  // começa com o prefixo da própria filial; null = vê todas as lojas.
  filial    String?
  // Desativar em vez de apagar: quem já contou alguma coisa não pode sumir
  // sem levar o histórico junto. Inativo não entra no sistema nem aparece
  // para receber tarefa.
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())

  atribuicoes   MovimentacaoAtribuicao[]
  conferencias  ConferenciaResultado[]
  itemAtribuicoes  ItemAtribuicao[]
  itemConferencias ItemConferenciaResultado[]
  segundasContagensSolicitadas ItemSolicitacaoSegundaContagem[] @relation("SolicitacoesFeitas")
  segundasContagensAtribuidas  ItemSolicitacaoSegundaContagem[] @relation("SolicitacoesAtribuidas")

  tarefasCriadas       Tarefa[]            @relation("TarefaCriadaPor")
  tarefasResponsavel   TarefaResponsavel[]
  prediosEncerrados    PredioEncerrado[]
  tratamentosMovDiaria TratamentoMovDiaria[]
  contagemItensIniciados      ContagemItem[] @relation("ContagemIniciadaPor")
  contagemItensConferidos1    ContagemItem[] @relation("ContagemConferidaPor1")
  contagemItensAtribuidos2    ContagemItem[] @relation("ContagemItensAtribuidos2")
  contagemItensConferidos2    ContagemItem[] @relation("ContagemConferidaPor2")
  contagemSegundasSolicitadas ContagemItem[] @relation("ContagemSegundaSolicitadaPor")
  contagemItensAtribuidos     ContagemItem[] @relation("ContagemAtribuidaPara")
  contagemItensQueAtribuiu    ContagemItem[] @relation("ContagemAtribuidaPor")

  ciclosAbertos  CicloContagem[] @relation("CicloAbertoPor")
  ciclosFechados CicloContagem[] @relation("CicloFechadoPor")

  notificacaoPreferencias NotificacaoPreferencia[]
  notificacoes            Notificacao[]

  contagensLivresCriadas     ContagemLivre[]           @relation("ContagemLivreCriadaPor")
  contagemLivreSessoes       ContagemLivreSessao[]
  contagemLivreRegistros     ContagemLivreRegistro[]
  contagemLivreRecontPedidas ContagemLivreRecontagem[] @relation("RecontagemPedidaPor")
  contagemLivreRecontAtrib   ContagemLivreRecontagem[] @relation("RecontagemAtribuidaPara")
  logsAcoes                  LogAcao[]
  locaisIgnorados            LocalIgnorado[]
  quarentenasMovidas         ContagemLivreQuarentena[]

  @@map("usuarios")
}

// Camada de "overlay" sobre a movimentação que existe no Sankhya: só guarda
// quem é o responsável por conferi-la. O restante do dado (nota, itens,
// quantidade esperada) vem ao vivo da API do Sankhya — não é duplicado aqui.
model MovimentacaoAtribuicao {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId             String?
  atualizadoEm          DateTime @updatedAt

  @@map("movimentacao_atribuicoes")
}

// Resultado de uma conferência física finalizada. Guarda um snapshot de
// nota/tipo/parceiro no momento da conferência para não depender de nova
// consulta ao Sankhya ao listar divergências/indicadores.
model ConferenciaResultado {
  id                    String   @id @default(uuid())
  movimentacaoSankhyaId String   @unique
  numeroNota            String
  tipo                  String
  parceiro              String
  empresaCodigo         String
  conferidoPor          Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId        String
  dataConferencia       DateTime

  itens        ItemConferido[]
  divergencias Divergencia[]

  @@map("conferencia_resultados")
}

model ItemConferido {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  // Código do local de armazenagem (extraído do itemSankhyaId, que já vem
  // como "{nunota}-{codigoProduto}-{localCodigo}") — precisa ficar salvo
  // aqui pra conferência diária casar contagens com produto+local+empresa+dia
  // sem depender de uma nova consulta ao Sankhya.
  localCodigo         String
  // Float, não Int: TGFEST.ESTOQUE pode ser fracionário (produtos vendidos
  // por metro/kg, ex: "118.17"). Int aqui derrubava o salvamento da
  // conferência pra qualquer produto medido em unidade fracionária.
  quantidadeEsperada  Float
  quantidadeConferida Int?

  @@map("itens_conferidos")
}

// Camada de "overlay" de atribuição por grupo produto+local, substituindo a
// atribuição por nota (MovimentacaoAtribuicao, acima): a unidade de trabalho
// da conferência física é "esse produto, nesse local" — o mesmo produto+local
// costuma aparecer espalhado em várias notas dentro do período, e não fazia
// sentido o admin ter que atribuir nota a nota pro operador ir contar a
// mesma prateleira várias vezes. `chave` é "{empresaCodigo}|{codigoProduto}|{localCodigo}",
// mesmo formato já usado em conferenciaDiaria.service.ts.
model ItemAtribuicao {
  id            String   @id @default(uuid())
  chave         String
  empresaCodigo String
  codigoProduto String
  localCodigo   String
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId     String?
  tarefa        Tarefa?  @relation(fields: [tarefaId], references: [id])
  tarefaId      String?
  atualizadoEm  DateTime @updatedAt

  @@unique([chave, tarefaId])
  @@index([tarefaId])
  @@map("item_atribuicoes")
}

// Resultado da conferência física de um grupo produto+local: uma contagem
// cega que vale pra todas as notas daquele produto+local no período
// (quantidadeEsperada já é o estoque físico do local — igual pra qualquer
// nota que passe por ali, não faz sentido contar nota a nota).
// numeroContagem 1 é a contagem original; 2 é a recontagem pedida pelo
// gestor quando a 1ª diverge (ver ItemSolicitacaoSegundaContagem) — cada
// chave pode ter até duas linhas aqui, uma por número de contagem.
model ItemConferenciaResultado {
  id                  String   @id @default(uuid())
  chave               String
  numeroContagem      Int      @default(1)
  empresaCodigo       String
  codigoProduto       String
  descricao           String
  local               String
  localCodigo         String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  conferidoPor        Usuario  @relation(fields: [conferidoPorId], references: [id])
  conferidoPorId      String
  dataConferencia     DateTime
  motivo              String?
  observacao          String?
  comentarioAdmin     String?
  // Valores lidos pelo leitor de código de barras/QR no momento da
  // contagem — guardados só como evidência de que o operador bipou algo
  // fisicamente ali (o Sankhya não tem código de barras cadastrado nos
  // produtos nesse ambiente, então não há o que validar contra).
  codigoLocalBipado    String?
  codigoProdutoBipado  String?
  // Mesma regra da contagem física: chave do objeto no MinIO, servida só
  // pelo proxy autenticado da API.
  fotoChaveArmazenamento String?
  // A tarefa de movimentação diária em que essa conferência foi feita. Sem
  // ela, um resultado gravado no dia 23 continuava colado no mesmo
  // produto+local hoje, porque a chave não tem data.
  tarefa   Tarefa? @relation(fields: [tarefaId], references: [id])
  tarefaId String?

  @@unique([chave, numeroContagem, tarefaId])
  @@map("item_conferencia_resultados")
}

// Fica registrada quando o gestor pede recontagem de um item com
// divergência na 1ª contagem. Enquanto existir sem a 2ª contagem
// correspondente em ItemConferenciaResultado, o item aparece pro
// `usuarioId` atribuído como "aguardando 2ª contagem".
model ItemSolicitacaoSegundaContagem {
  id              String   @id @default(uuid())
  chave           String
  solicitadoPor   Usuario  @relation("SolicitacoesFeitas", fields: [solicitadoPorId], references: [id])
  solicitadoPorId String
  usuario         Usuario? @relation("SolicitacoesAtribuidas", fields: [usuarioId], references: [id])
  usuarioId       String?
  // A recontagem pertence à tarefa em que a divergência apareceu: sem isso,
  // um pedido feito ontem reaparecia colado no item de uma tarefa de hoje.
  tarefaId        String?
  criadoEm        DateTime @default(now())

  @@unique([chave, tarefaId])
  @@map("item_solicitacoes_segunda_contagem")
}

// Central de avisos. `usuarioId` null = destinatário padrão (todos os
// admins, comportamento de sempre); preenchido = essa linha é só pra esse
// usuário específico — criada quando existe NotificacaoPreferencia
// configurada pro `tipo`, uma linha por destinatário configurado.
model Notificacao {
  id        String   @id @default(uuid())
  tipo      String
  chave     String
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId String?

  @@map("notificacoes")
}

// Configuração de "quem recebe qual tipo de notificação", feita pelo admin
// em Configurações. Sem nenhuma linha pra um `tipo`, o padrão é notificar
// todos os admins (mesmo comportamento de antes dessa configuração existir).
model NotificacaoPreferencia {
  id        String   @id @default(uuid())
  tipo      String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  criadoEm  DateTime @default(now())

  @@unique([tipo, usuarioId])
  @@map("notificacao_preferencias")
}

// Marca produtos com estoque negativo já notificados, pra não avisar de
// novo a cada checagem periódica — só quando o produto+empresa "some" da
// lista de negativados (voltou a ficar >= 0) é que ele é liberado pra
// notificar de novo se ficar negativo outra vez.
model ProdutoNegativadoRastreado {
  id          String   @id @default(uuid())
  chave       String   @unique // "{empresaCodigo}|{codigoProduto}"
  detectadoEm DateTime @default(now())

  @@map("produtos_negativados_rastreados")
}

// Última versão publicada do APK — o app consulta essa tabela (via rota
// pública) toda vez que abre, compara `versionCode` com a versão instalada
// e, se tiver uma mais nova, baixa o APK direto daqui (MinIO) e abre o
// instalador do Android. Nunca é atualizada por linha existente: cada
// publicação cria uma linha nova, a mais recente por `versionCode` vence.
model AppVersao {
  id          String   @id @default(uuid())
  versionCode Int
  versionName String
  apkChave    String
  notas       String?
  obrigatoria Boolean  @default(false)
  publicadoEm DateTime @default(now())

  @@map("app_versoes")
}

// Contagem física livre: o colaborador bipa produto+local por conta própria
// (sem admin pré-carregar/atribuir nada) e a linha só nasce nesse momento —
// não existe estado "pendente" esperando alguém, porque ninguém sabe que vai
// contar aquele produto+local até o colaborador decidir contar. O sistema
// busca a quantidade esperada na cópia de estoque (TGFCTE) ao vivo, na hora
// do "iniciar", e guarda esse retrato pra comparar quando ele enviar.
//
// status: EM_ANDAMENTO (bipou, ainda não enviou a 1ª) | CONFERIDA | DIVERGENCIA
//   | AGUARDANDO_SEGUNDA_CONTAGEM (divergiu, gestor pediu recontagem, ninguém
//   bipou ainda pra ela) | SEGUNDA_EM_ANDAMENTO (recontagem bipada, ainda não
//   enviada).
// Um inventário: o recorte que delimita "uma contagem".
//
// Antes disso a contagem era uma tabela solta filtrada por data, e comparar
// dois inventários dependia de alguém lembrar as datas exatas de cada um.
// Com o ciclo, "a contagem de setembro" é uma coisa que existe, tem começo,
// fim e dono, e pode ser comparada com a anterior sem ambiguidade.
//
// Só um ciclo fica ABERTO por vez: toda atribuição nova cai nele. Fechar um
// ciclo congela o recorte — os itens continuam lá, mas nada novo entra.
model CicloContagem {
  id     String @id @default(uuid())
  nome   String
  // ABERTO | FECHADO
  status String @default("ABERTO")

  abertoEm    DateTime  @default(now())
  abertoPor   Usuario?  @relation("CicloAbertoPor", fields: [abertoPorId], references: [id])
  abertoPorId String?
  fechadoEm   DateTime?
  fechadoPor  Usuario?  @relation("CicloFechadoPor", fields: [fechadoPorId], references: [id])
  fechadoPorId String?

  observacao String?

  itens ContagemItem[]

  @@map("ciclos_contagem")
  tarefas Tarefa[]
}

// A TAREFA é a unidade de trabalho e, principalmente, o recorte dos dados.
//
// Antes, contagem de inventário e conferência de nota caíam no mesmo balaio:
// quem abria um relatório do dia 23 recebia o inventário daquele dia somado às
// movimentações, e não havia como separar. Agora todo item nasce dentro de uma
// tarefa, a tarefa tem TIPO, e relatórios/dashboards recortam por ela.
model Tarefa {
  id     String @id @default(uuid())
  nome   String
  // 'CONTAGEM' (inventário/contagem por local) ou 'MOV_DIARIA' (conferência
  // do que entrou e saiu por nota). É o que impede os dois de se misturarem.
  tipo   String
  // 'ABERTA' | 'FECHADA'. A operação combinou fechar no mesmo dia em que abre:
  // tarefa que atravessa o dia incorpora movimentação do dia seguinte.
  status String @default("ABERTA")

  // Só nas tarefas de contagem: a qual inventário ela pertence.
  ciclo   CicloContagem? @relation(fields: [cicloId], references: [id])
  cicloId String?

  // Só nas de movimentação diária: de que dia são as notas conferidas.
  diaReferencia DateTime?

  criadaPor   Usuario  @relation("TarefaCriadaPor", fields: [criadaPorId], references: [id])
  criadaPorId String
  criadaEm    DateTime @default(now())
  fechadaEm   DateTime?
  observacao  String?

  // Projeto é somente uma identificação organizacional. Ele agrupa tarefas
  // sem mudar a identidade dos itens nem misturar CONTAGEM e MOV_DIARIA.
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  projetoId String?

  responsaveis      TarefaResponsavel[]
  contagemItens     ContagemItem[]
  itemAtribuicoes   ItemAtribuicao[]
  itemResultados    ItemConferenciaResultado[]
  prediosEncerrados PredioEncerrado[]
  tratamentos       TratamentoMovDiaria[]

  @@map("tarefas")
  @@index([projetoId])
}

// Um projeto é a pasta lógica do gestor (ex.: "Inventário Setembro"). Não é
// uma etapa de execução: as regras, responsáveis e dados continuam na tarefa.
model Projeto {
  id        String   @id @default(uuid())
  nome      String
  criadoEm  DateTime @default(now())
  tarefas   Tarefa[]

  @@map("projetos")
}

// O que o gestor apurou num item de Mov. Diária depois que o colaborador
// encerrou a tarefa.
//
// O colaborador só COLETA: ele conta às cegas e não vê esperado, conferido
// nem diferença. A explicação vem depois, aqui — preço de tabela e quanto
// entrou e saiu chegam prontos do Sankhya, e o gestor corrige o que estiver
// errado. Só o que ele encostou fica marcado como editado; o resto continua
// acompanhando o Sankhya se o número de lá mudar.
model TratamentoMovDiaria {
  id       String @id @default(uuid())
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  tarefaId String
  // "empresa|produto|local", a mesma chave da conferência.
  chave String

  precoTabela       Float?
  quantidadeEntrada Float?
  quantidadeSaida   Float?

  editadoPreco   Boolean @default(false)
  editadoEntrada Boolean @default(false)
  editadoSaida   Boolean @default(false)

  comentario String?

  tratadoPor   Usuario @relation(fields: [tratadoPorId], references: [id])
  tratadoPorId String
  atualizadoEm DateTime @updatedAt

  @@unique([tarefaId, chave])
  @@map("tratamentos_mov_diaria")
}

// Um prédio que o colaborador declarou terminado.
//
// Sem isso, um prédio já varrido continuava na lista dele igual aos outros,
// e a única forma de tirá-lo da frente era contar item por item o que não
// estava lá. Encerrar tem dois caminhos, e o colaborador escolhe na hora:
// registrar 0 no que sobrou (não achei) ou deixar pendente pra outra pessoa.
// `pendentes` guarda quantos ficaram sem contar, que é o que o gestor
// precisa ver pra saber se o prédio foi varrido ou abandonado.
model PredioEncerrado {
  id       String @id @default(uuid())
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  tarefaId String

  empresaCodigo String
  // String vazia, não null: a chave única precisa comparar e no Postgres
  // NULL nunca é igual a NULL — dois "sem endereço" passariam batido.
  rua    String
  predio String
  // Quem encerra é quem está na prateleira, e a prateleira é o NÍVEL: é o
  // nível que tem etiqueta, e é nele que a pessoa está de pé.
  nivel  String @default("")

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  pendentes   Int      @default(0)
  encerradoEm DateTime @default(now())

  @@unique([tarefaId, usuarioId, empresaCodigo, rua, predio, nivel])
  @@map("predios_encerrados")
}

// Mais de uma pessoa na mesma tarefa. Os itens continuam tendo um dono cada
// (repartidos em rodízio), mas a tarefa é do grupo.
model TarefaResponsavel {
  id        String   @id @default(uuid())
  tarefa    Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  tarefaId  String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  criadoEm  DateTime @default(now())

  @@unique([tarefaId, usuarioId])
  @@map("tarefa_responsaveis")
}

model ContagemItem {
  id String @id @default(uuid())

  // Inventário a que este item pertence. Nulo só nas linhas criadas antes do
  // ciclo existir (ver a migração 20260918000000_ciclo_contagem).
  ciclo   CicloContagem? @relation(fields: [cicloId], references: [id])
  cicloId String?

  empresaCodigo      String
  empresaNome        String
  codigoProduto      String
  descricao          String
  unidade            String
  local              String
  localCodigo        String

  // O saldo vem do estoque REAL do Sankhya (TGFEST), relido a cada 5 minutos
  // — não mais da cópia de estoque diária. São três números porque a operação
  // usa os três:
  //   quantidadeTotal     = tudo que o sistema diz que está no local
  //   quantidadeReservada = preso em pedido pendente (já separado pra entrega)
  //   quantidadeEsperada  = total - reservada, e é contra ELE que a contagem
  //                         é conferida: o item reservado já saiu da prateleira.
  quantidadeEsperada  Float
  quantidadeTotal     Float?
  quantidadeReservada Float  @default(0)
  // Momento em que esse saldo foi lido do Sankhya.
  dataSaldo           DateTime?
  // Itens criados antes da virada pro saldo real guardam aqui a data da cópia
  // de estoque que os originou. Não é mais preenchido.
  dataCopiaEstoque    DateTime?

  // Rua/prédio extraídos de `local` na hora da atribuição (parsearLocalizacao,
  // ver src/sankhya/localizacao.ts) — persistidos, não recalculados depois,
  // pra agrupar a contagem por prédio mesmo que a descrição mude no Sankhya.
  // Null quando o local não bate com o padrão rua/prédio reconhecido.
  rua    String?
  predio String?
  // Nível dentro do prédio ("NÍVEL 1", "N.2") — permite atribuir a contagem
  // por nível em vez do prédio inteiro. Null quando o nome do local não traz.
  nivel  String?

  // Item encontrado fisicamente num local diferente do que o ERP esperava
  // (o colaborador achou um "intruso" na prateleira que estava contando).
  // localEsperado guarda onde o Sankhya dizia que ele deveria estar, pra o
  // admin conseguir tomar providência sobre a etiqueta/endereçamento.
  divergenciaLocal Boolean @default(false)
  localEsperado    String?

  // status "PENDENTE" = atribuído pelo admin, ainda não bipado pelo colaborador.
  status        String   @default("PENDENTE")
  iniciadoPor   Usuario? @relation("ContagemIniciadaPor", fields: [iniciadoPorId], references: [id])
  iniciadoPorId String?
  iniciadoEm    DateTime?

  // Atribuição da 1ª contagem — quem deve contar esse item e quem atribuiu.
  // Preenchida na criação (atribuirContagemPredio); iniciadoPor/iniciadoEm só
  // são preenchidos quando o colaborador efetivamente bipa e começa a contar.
  atribuidoPara   Usuario? @relation("ContagemAtribuidaPara", fields: [atribuidoParaId], references: [id])
  atribuidoParaId String?
  atribuidoPor    Usuario? @relation("ContagemAtribuidaPor", fields: [atribuidoPorId], references: [id])
  atribuidoPorId  String?
  atribuidoEm     DateTime @default(now())
  // A tarefa a que este item pertence. É por ela que relatório e dashboard
  // recortam os dados.
  tarefa   Tarefa? @relation(fields: [tarefaId], references: [id])
  tarefaId String?
  // Nome que o admin deu à tarefa na hora de atribuir ("Rua 2 manhã",
  // "Recontagem do Aldir"). É só um rótulo pra encontrar o lote depois na
  // aba Contagens — sem ele o gestor só tem rua/prédio pra se orientar, e
  // dois lotes do mesmo prédio ficam indistinguíveis.
  tarefaNome      String?

  // 1ª contagem
  quantidadeConferida    Int?
  diferenca              Float?
  motivo                 String?
  observacao             String?
  comentarioAdmin        String?
  dataConferencia        DateTime?
  conferidoPor           Usuario?  @relation("ContagemConferidaPor1", fields: [conferidoPorId], references: [id])
  conferidoPorId         String?
  codigoLocalBipado      String?
  codigoProdutoBipado    String?
  // Chave do objeto no MinIO (nunca uma URL pública) — a foto só é servida
  // via proxy autenticado da nossa API, o app não recebe acesso direto ao
  // bucket nem essa foto aparece em nenhuma tela do operador.
  fotoChaveArmazenamento String?

  // pedido de 2ª contagem
  segundaContagemSolicitada      Boolean  @default(false)
  segundaContagemSolicitadaPor   Usuario? @relation("ContagemSegundaSolicitadaPor", fields: [segundaContagemSolicitadaPorId], references: [id])
  segundaContagemSolicitadaPorId String?
  segundaContagemUsuario         Usuario? @relation("ContagemItensAtribuidos2", fields: [segundaContagemUsuarioId], references: [id])
  segundaContagemUsuarioId       String?
  segundaContagemIniciadaEm      DateTime?

  // 2ª contagem
  quantidadeConferida2    Int?
  diferenca2              Float?
  motivo2                 String?
  observacao2             String?
  dataConferencia2        DateTime?
  conferidoPor2           Usuario?  @relation("ContagemConferidaPor2", fields: [conferidoPor2Id], references: [id])
  conferidoPor2Id         String?
  codigoLocalBipado2      String?
  codigoProdutoBipado2    String?
  fotoChaveArmazenamento2 String?

  @@map("contagem_itens")
}

model Divergencia {
  id                  String               @id @default(uuid())
  conferencia         ConferenciaResultado @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  conferenciaId       String
  itemSankhyaId       String
  codigoProduto       String
  descricao           String
  quantidadeEsperada  Float
  quantidadeConferida Int
  diferenca           Float
  motivo              String
  observacao          String?
  comentarioAdmin     String?

  @@map("divergencias")
}


// ---------------------------------------------------------------------------
// Contagem livre (01/10/2026)
// ---------------------------------------------------------------------------
//
// Substitui a distribuição de tarefas. O gestor escolhe uma CÓPIA DE ESTOQUE
// do Sankhya (TGFCTE: sai uma por dia e por empresa, sempre às 00:00) e a
// equipe conta contra ela: bipa a etiqueta do local, bipa os produtos que
// estão ali, registra a quantidade e finaliza o local.
//
// Ninguém recebe lista de itens. Quem conta escolhe o local; o sistema só
// confere se o produto bipado pertence a ele e se já não foi contado.
model ContagemLivre {
  id        String   @id @default(uuid())
  nome      String
  // TGFCTE.DTCONTAGEM da cópia escolhida. É ela que vira o rótulo
  // "Cópia Estoque Dia 01/10/2026" no app e no painel.
  dataCopia DateTime
  // CODEMP que entram. Uma empresa só pode estar numa contagem ativa por vez:
  // é assim que o celular de cada loja sabe, sem perguntar, contra o quê está
  // contando.
  empresas  String[]
  // PREPARANDO → ATIVA → ENCERRADA. PREPARANDO é o tempo de copiar ~23 mil
  // linhas do Sankhya; ERRO guarda o motivo em `erro`.
  status    String   @default("PREPARANDO")
  erro      String?

  // Configurações, mudáveis com a contagem em andamento.
  //   fotoObrigatoria — foto exigida a cada registro; desligada, a etapa some.
  //   travaLocal      — só aceita produto que a cópia diz estar naquele local.
  //                     O que estiver fora entra pelo "registrar fora do local".
  //   travaDuplicada  — o mesmo produto no mesmo local só é contado uma vez.
  fotoObrigatoria Boolean @default(true)
  travaLocal      Boolean @default(true)
  travaDuplicada  Boolean @default(true)

  criadaPor   Usuario   @relation("ContagemLivreCriadaPor", fields: [criadaPorId], references: [id])
  criadaPorId String
  criadaEm    DateTime  @default(now())
  encerradaEm DateTime?

  estoque     ContagemLivreEstoque[]
  sessoes     ContagemLivreSessao[]
  registros   ContagemLivreRegistro[]
  recontagens ContagemLivreRecontagem[]
  donos       ContagemLivreItemDono[]
  quarentenas ContagemLivreQuarentena[]

  @@index([status])
  @@map("contagem_livre")
}

// O retrato da cópia, gravado uma vez quando a contagem é criada. Copiar pra
// cá em vez de consultar o Sankhya a cada bipe é o que deixa a conferência
// instantânea e imune a queda do gateway no meio do galpão.
model ContagemLivreEstoque {
  id            String        @id @default(uuid())
  contagem      ContagemLivre @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId    String
  empresaCodigo String
  codigoProduto String
  descricao     String
  unidade       String
  localCodigo   String
  local         String
  // TGFCTE.QTDEST somado (o mesmo produto+local vem em mais de uma linha
  // quando tem lote: 34 pares na cópia de 01/10).
  quantidadeTotal     Float
  // TGFEST.RESERVADO no momento em que a contagem foi criada — a cópia não
  // traz reserva. Disponível = total − reservado.
  quantidadeReservada Float  @default(0)
  // TGFCUS.CUSSEMICM mais recente do produto na empresa.
  custoSemIcms        Float?

  @@unique([contagemId, codigoProduto, localCodigo, empresaCodigo])
  @@index([contagemId, localCodigo])
  @@index([contagemId, codigoProduto])
  @@map("contagem_livre_estoque")
}

// Um local aberto por alguém: do bipe da etiqueta até "Finalizar".
model ContagemLivreSessao {
  id             String        @id @default(uuid())
  contagem       ContagemLivre @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId     String
  localCodigo    String
  local          String
  empresaCodigo  String?
  // 1 = contagem; 2 = recontagem pedida pelo gestor.
  numeroContagem Int           @default(1)
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  usuarioId      String
  iniciadaEm     DateTime      @default(now())
  finalizadaEm   DateTime?

  registros ContagemLivreRegistro[]

  @@index([contagemId, localCodigo])
  @@index([usuarioId, finalizadaEm])
  @@map("contagem_livre_sessoes")
}

model ContagemLivreRegistro {
  id             String              @id @default(uuid())
  contagem       ContagemLivre       @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId     String
  sessao         ContagemLivreSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  sessaoId       String
  numeroContagem Int                 @default(1)
  empresaCodigo  String
  codigoProduto  String
  descricao      String
  unidade        String
  localCodigo    String
  local          String
  quantidade     Float
  // O produto não consta na cópia NAQUELE local. Calculado pelo servidor,
  // nunca informado pelo app: vale mesmo com a trava de local desligada.
  foraDoLocal    Boolean             @default(false)
  codigoBipado   String?
  usuario        Usuario             @relation(fields: [usuarioId], references: [id])
  usuarioId      String
  // Bipe (ou escolha) do produto → toque em "Registrar".
  iniciadoEm     DateTime
  registradoEm   DateTime            @default(now())
  fotoChave      String?
  // A trava de duplicidade mora no banco: preenchida (contagem|produto|local|
  // empresa|número) quando a trava está ligada, nula quando desligada. O
  // Postgres aceita vários NULL num índice único, então desligar a trava
  // libera a repetição sem mudar o esquema — e ligada, nem dois celulares
  // registrando no mesmo instante conseguem furar.
  chaveUnica     String?             @unique

  @@index([contagemId, codigoProduto, localCodigo])
  @@index([sessaoId])
  @@index([contagemId, usuarioId])
  @@map("contagem_livre_registros")
}

// Item que o gestor mandou recontar. Quem reconta não pode ser quem contou.
model ContagemLivreRecontagem {
  id              String        @id @default(uuid())
  contagem        ContagemLivre @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId      String
  empresaCodigo   String
  codigoProduto   String
  descricao       String
  unidade         String
  localCodigo     String
  local           String
  solicitadaPor   Usuario       @relation("RecontagemPedidaPor", fields: [solicitadaPorId], references: [id])
  solicitadaPorId String
  solicitadaEm    DateTime      @default(now())
  // Nulo = qualquer colaborador da loja, menos quem fez a 1ª contagem.
  atribuidaPara   Usuario?      @relation("RecontagemAtribuidaPara", fields: [atribuidaParaId], references: [id])
  atribuidaParaId String?
  concluidaEm     DateTime?

  @@unique([contagemId, codigoProduto, localCodigo, empresaCodigo])
  @@index([contagemId, localCodigo])
  @@map("contagem_livre_recontagens")
}


// Quem contou cada item (contagem|produto|local|empresa|número). Uma linha só
// por item, garantida pelo banco: é o que impede duas pessoas de contarem o
// mesmo produto no mesmo local, com a trava de duplicidade ligada OU
// desligada. Desligada, ela só deixa a MESMA pessoa somar em partes.
//
// Nasceu de um caso real (02/10/2026): Rone e Ytann contaram os mesmos 4
// produtos no local 202023, com a trava desligada, e as contagens se somaram.
model ContagemLivreItemDono {
  chave      String        @id
  contagem   ContagemLivre @relation(fields: [contagemId], references: [id], onDelete: Cascade)
  contagemId String
  usuarioId  String
  criadoEm   DateTime      @default(now())

  @@index([contagemId])
  @@map("contagem_livre_item_donos")
}

// Item divergente que o gestor mandou pra quarentena: sai das divergências e
// da acuracidade, e fica aqui como registro — com os números do momento, pra
// o relatório de quarentena não depender da contagem continuar existindo.
model ContagemLivreQuarentena {
  id                   String         @id @default(uuid())
  contagem             ContagemLivre? @relation(fields: [contagemId], references: [id], onDelete: SetNull)
  contagemId           String?
  contagemNome         String
  empresaCodigo        String
  codigoProduto        String
  descricao            String
  unidade              String
  localCodigo          String
  local                String
  quantidadeContada    Float
  quantidadeDisponivel Float
  quantidadeDivergente Float
  custoUnitario        Float?
  observacao           String?
  usuario              Usuario        @relation(fields: [usuarioId], references: [id])
  usuarioId            String
  criadoEm             DateTime       @default(now())

  @@unique([contagemId, codigoProduto, localCodigo, empresaCodigo])
  @@index([criadoEm])
  @@map("contagem_livre_quarentenas")
}

// Locais que existem no Sankhya mas não são usados (endereçamento antigo,
// áreas desativadas). Ficam fora da contagem inteira: não abrem no celular,
// não entram no progresso, nos "não contados" nem na acuracidade.
model LocalIgnorado {
  localCodigo String   @id
  local       String
  motivo      String?
  criadoPor   Usuario  @relation(fields: [criadoPorId], references: [id])
  criadoPorId String
  criadoEm    DateTime @default(now())

  @@map("locais_ignorados")
}

// Trilha do que cada pessoa fez no sistema — inclusive quem desligou trava,
// excluiu ou editou. O nome vai copiado: o log sobrevive ao login apagado.
model LogAcao {
  id           String   @id @default(uuid())
  usuario      Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId    String?
  usuarioNome  String
  acao         String
  descricao    String
  detalhes     Json?
  criadoEm     DateTime @default(now())

  @@index([criadoEm])
  @@index([acao])
  @@index([usuarioId])
  @@map("logs_acoes")
}
